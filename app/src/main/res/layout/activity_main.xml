<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6F5"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#174D42">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="فیت‌یار"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:gravity="right"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="هر روز، یک قدم نزدیک‌تر به هدفت"
                android:textColor="#D6E9E3"
                android:textSize="15sp"
                android:gravity="right"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="برنامه‌ریزی کن؛ پیشرفتت را ثبت کن."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="right"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="12dp"
            android:text="فضای تمرین شما"
            android:textColor="#183B34"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="right"/>

        <Button
            android:id="@+id/managePlansButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="10dp"
            android:text="برنامه‌ها و حرکات"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:backgroundTint="#246B5A"
            android:allCaps="false"
            android:minHeight="60dp"/>
        <Button
            android:id="@+id/logWorkoutButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="10dp"
            android:text="ثبت تمرین"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:backgroundTint="#327E6C"
            android:allCaps="false"
            android:minHeight="60dp"/>
        <Button
            android:id="@+id/stepsButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="10dp"
            android:text="قدم‌شمار"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#21483F"
            android:gravity="center"
            android:backgroundTint="#DCECE6"
            android:allCaps="false"
            android:minHeight="60dp"/>
        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="خروجی و ذخیره سوابق"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#21483F"
            android:gravity="center"
            android:backgroundTint="#E5EAE8"
            android:allCaps="false"
            android:minHeight="60dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:text="اطلاعات تمرین روی دستگاه شما ذخیره می‌شود."
            android:textColor="#536761"
            android:textSize="14sp"
            android:gravity="right"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="فیت‌یار • همراه تمرین‌های روزانه"
            android:textColor="#82918C"
            android:textSize="12sp"
            android:gravity="center"/>
    </LinearLayout>
</ScrollView>
