<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FB"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="26dp"
            android:background="@drawable/bg_hero">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="فیت‌یار"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="right"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="قوی‌تر از دیروز؛ هر روز"
                android:textColor="#DCE9FF"
                android:textSize="16sp"
                android:gravity="right"/>
            <View
                android:layout_width="52dp"
                android:layout_height="4dp"
                android:layout_marginTop="22dp"
                android:background="#9EF0C5"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="برنامه‌ات را بساز و مسیر پیشرفتت را ثبت کن."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="right"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="14dp"
            android:text="امروز چه کاری انجام می‌دهی؟"
            android:textColor="#17233D"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="right"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_action_card">
            <Button
                android:id="@+id/logWorkoutButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="10dp"
                android:text="ثبت تمرین"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#365CF5"
                android:textAllCaps="false"
                android:minHeight="64dp"/>
            <Button
                android:id="@+id/managePlansButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="10dp"
                android:text="برنامه‌ها و حرکات"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#23345B"
                android:backgroundTint="#EAF0FF"
                android:textAllCaps="false"
                android:minHeight="60dp"/>
            <Button
                android:id="@+id/stepsButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="10dp"
                android:text="قدم‌شمار"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#17664D"
                android:backgroundTint="#E4F8EE"
                android:textAllCaps="false"
                android:minHeight="60dp"/>
            <Button
                android:id="@+id/exportButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="خروجی و ذخیره سوابق"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#5A3E13"
                android:backgroundTint="#FFF2D9"
                android:textAllCaps="false"
                android:minHeight="60dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="18dp"
            android:background="@drawable/bg_status_card"
            android:text="اطلاعات تمرین روی دستگاه شما ذخیره می‌شود."
            android:textColor="#53617A"
            android:textSize="14sp"
            android:gravity="right"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="فیت‌یار  •  همراه تمرین‌های روزانه"
            android:textColor="#8A94A8"
            android:textSize="12sp"
            android:gravity="center"/>
    </LinearLayout>
</ScrollView>
